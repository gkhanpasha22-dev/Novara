# Скопируйте в .env рядом с этим файлом.

# Токен бота от @BotFather. Без него сервис поднимется в демо-режиме
# (панель работает, сообщения никуда не уходят) — этого достаточно, чтобы показать продукт.
BOT_TOKEN=

# Chat ID владельца: туда придёт сводка дня. Узнать: написать боту и открыть /api/whoami,
# либо посмотреть в логе сервера при первом сообщении.
OWNER_CHAT_ID=

# Час отправки сводки дня (0-23, местное время сервера).
DIGEST_HOUR=20

# Пароль входа в панель. Если пусто — панель открыта всем, кто знает адрес.
# Для прототипа на localhost это нормально, для показа «в поле» — задайте.
PANEL_PASSWORD=

# Порт веб-панели.
PORT=8787

# Автоответ на первое сообщение нового клиента (пусто — выключено).
AUTOREPLY=Здравствуйте! Ваше сообщение получено, ответим в течение 15 минут.
